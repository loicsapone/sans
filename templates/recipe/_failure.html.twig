<section class="failure" id="url-error" role="alert">
    <svg class="failure__mark" width="56" height="56" viewBox="0 0 32 32" fill="none" stroke="#9CA3AF" stroke-width="1.6" stroke-linecap="round" aria-hidden="true">
        <circle cx="16" cy="16" r="12"/>
        <line x1="7.5" y1="24.5" x2="24.5" y2="7.5"/>
    </svg>
    <h1 class="failure__title">{{ failure.title }}</h1>
    <p class="failure__text">{{ failure.text }}</p>
    <ul class="failure__tips">
        {% for tip in failure.tips %}
            <li><span aria-hidden="true">→</span>{{ tip }}</li>
        {% endfor %}
    </ul>
</section>
