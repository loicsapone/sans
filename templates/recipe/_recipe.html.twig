<div class="recipe">
    <article class="recipe__main">
        <p class="recipe__meta">{{ view.meta }}</p>
        <h1 class="recipe__title">{{ view.title }}</h1>

        <div class="recipe__heading">
            <h2 class="recipe__section">Ingredients</h2>
            {% if view.hasAdaptation %}
                <div class="version" role="group" aria-label="Recipe version">
                    <button class="version__button{{ view.showsOriginal ? '' : ' version__button--yours' }}" type="button" aria-pressed="{{ view.showsOriginal ? 'false' : 'true' }}" data-action="live#action" data-live-action-param="setVersion" data-live-version-param="yours">Your version</button>
                    <button class="version__button{{ view.showsOriginal ? ' version__button--original' : '' }}" type="button" aria-pressed="{{ view.showsOriginal ? 'true' : 'false' }}" data-action="live#action" data-live-action-param="setVersion" data-live-version-param="original">Original</button>
                </div>
            {% endif %}
        </div>
        <ul class="ingredients">
            {% for row in view.ingredients %}
                {% if view.pending %}
                    <li class="ingredient ingredient--pending">
                        <span class="ingredient__quantity">{{ row.quantity }}</span>
                        <span>{{ row.name }}</span>
                        <span class="ingredient__note" aria-hidden="true"><span class="shimmer shimmer--note"></span></span>
                    </li>
                {% else %}
                    <li class="ingredient{{ row.pending ? ' ingredient--swapping' : '' }}"{% if row.pending %} aria-busy="true"{% endif %}>
                        {% if row.pending %}
                            <span class="shimmer shimmer--quantity" aria-hidden="true"></span>
                            <div class="ingredient__swapping">
                                <span class="ingredient__struck">{{ row.quantity }} {{ row.name }}</span>
                                <span class="shimmer shimmer--swap" aria-hidden="true"></span>
                                <span class="ingredient__finding">Finding a {{ row.pending }} swap…</span>
                            </div>
                            <span></span>
                        {% elseif row.swap %}
                            <span class="ingredient__quantity ingredient__quantity--swapped">{{ row.swap.quantity }}</span>
                            <div>
                                <div class="ingredient__name ingredient__name--swapped">{{ row.swap.name }}</div>
                                <div class="ingredient__why"><span class="ingredient__swap">Sans swap · </span>{{ row.swap.role }}</div>
                            </div>
                            <span class="ingredient__was">was {{ row.swap.was }}</span>
                        {% else %}
                            <span class="ingredient__quantity">{{ row.quantity }}</span>
                            {% if row.unidentified %}
                                {% set answered = row.unidentified|filter(unknown => not unknown.declared)|length == 0 %}
                                <details class="declare" id="declare-{{ loop.index0 }}" data-controller="disclosure">
                                    <summary class="declare__summary">
                                        <span>{{ row.name }}</span>
                                        <span class="declare__state">
                                            {% if answered %}
                                                <span class="ingredient__note">{{ row.note ?: 'No allergen' }}</span>
                                                <span class="declare__told">you told us</span>
                                                <span class="declare__action">Edit</span>
                                            {% else %}
                                                {% if row.note %}<span class="ingredient__note">{{ row.note }}</span>{% endif %}
                                                <span class="declare__missing">Not identified</span>
                                                <span class="declare__action">Add allergens</span>
                                            {% endif %}
                                        </span>
                                    </summary>
                                    {% for unknown in row.unidentified %}
                                        <fieldset class="declare__panel">
                                            <legend class="declare__question">Which allergens are in {{ unknown.name }}?</legend>
                                            <div class="declare__choices">
                                                {% for choice in view.allergenChoices %}
                                                    <button class="chip" type="button" aria-pressed="{{ choice.value in unknown.allergens ? 'true' : 'false' }}" data-action="live#action disclosure#close" data-live-action-param="declareAllergen" data-live-ingredient-param="{{ unknown.name }}" data-live-allergen-param="{{ choice.value }}">{{ choice.label }}</button>
                                                {% endfor %}
                                            </div>
                                            <div class="declare__choices">
                                                <button class="chip chip--none" type="button" aria-pressed="{{ unknown.declared and not unknown.allergens ? 'true' : 'false' }}" data-action="live#action disclosure#close" data-live-action-param="declareNone" data-live-ingredient-param="{{ unknown.name }}">None of these</button>
                                                {% if unknown.declared %}
                                                    <button class="declare__undo" type="button" data-action="live#action disclosure#close" data-live-action-param="undeclare" data-live-ingredient-param="{{ unknown.name }}">I don’t know</button>
                                                {% endif %}
                                            </div>
                                        </fieldset>
                                    {% endfor %}
                                </details>
                            {% else %}
                                <span>{{ row.name }}</span>
                                <span class="ingredient__note">{{ row.note }}</span>
                            {% endif %}
                            {% if row.failed %}<span class="ingredient__failed">{{ row.failed }}</span>{% endif %}
                        {% endif %}
                        {% if row.mayCarry %}
                            <twig:ProductLabel loading="defer" loading-tag="span" class="ingredient__label" :url="view.url" :line="loop.index0" :avoided="view.avoided" :key="'label-' ~ loop.index0 ~ '-' ~ view.avoided|join('-')"/>
                        {% endif %}
                    </li>
                {% endif %}
            {% endfor %}
        </ul>

        <div class="recipe__heading recipe__heading--method">
            <h2 class="recipe__section recipe__section--method">Method</h2>
            {% if view.isAdapting and view.pendingStepCount %}<span class="recipe__progress">Rewriting {{ view.pendingStepCount }} step{{ view.pendingStepCount == 1 ? '' : 's' }}…</span>{% endif %}
        </div>
        <ol class="method">
            {% for step in view.steps %}
                <li class="method__step{{ step.pending ? ' method__step--pending' : '' }}"{% if step.pending %} aria-busy="true"{% endif %}>
                    <span class="method__number">{{ step.number }}</span>
                    {% if step.pending %}
                        <div class="method__shimmer" aria-hidden="true"><span class="shimmer shimmer--line"></span><span class="shimmer shimmer--line shimmer--short"></span></div>
                    {% else %}
                    <p>{{ step.text }}{% if step.adapted %}<span class="method__adapted">adapted</span>{% endif %}</p>
                    {% endif %}
                </li>
            {% endfor %}
        </ol>
    </article>

    <aside class="card">
        <h2 class="card__title">Allergens</h2>
        {% if view.pending %}
            <p class="card__pending" role="status">Checking the 14 allergens…</p>
            {% for i in 1..6 %}
                <div class="shimmer shimmer--row" aria-hidden="true"></div>
            {% endfor %}
        {% else %}
            <p class="card__hint">Tap <svg width="16" height="16" viewBox="0 0 32 32" fill="none" stroke="#6B7280" stroke-width="3" stroke-linecap="round" aria-hidden="true"><circle cx="16" cy="16" r="12"/><line x1="7.5" y1="24.5" x2="24.5" y2="7.5"/></svg> to cook without it.</p>

            {% if view.isAdapting %}
                <p class="card__updating" role="status">Sans is updating the recipe…</p>
            {% elseif adaptationFailed|default(false) %}
                <p class="card__warning" role="status">Sans couldn’t find swaps this time. Tap again to retry.</p>
            {% endif %}
            {% if view.swapCount %}
                <p class="card__summary">{{ view.swapCount }} ingredient{{ view.swapCount == 1 ? '' : 's' }} swapped, {{ view.adaptedStepCount }} step{{ view.adaptedStepCount == 1 ? '' : 's' }} adapted.</p>
            {% endif %}

            <p class="card__group">Found in this recipe</p>
            {% for row in view.found %}
                <div class="allergen">
                    <div class="allergen__text">
                        {% if row.active %}
                            <div class="allergen__label"><span class="allergen__sans">sans </span>{{ row.label|lower }}</div>
                            <div class="allergen__status{{ row.swapped ? ' allergen__status--swapped' : '' }}">{{ row.status }}</div>
                        {% else %}
                            <div class="allergen__label">{{ row.label }}</div>
                            <div class="allergen__status">{{ row.status }}</div>
                        {% endif %}
                    </div>
                    <twig:AllergenToggle :label="row.label" :pressed="row.active" :busy="row.busy" data-action="live#action" data-live-action-param="toggleAllergen" :data-live-allergen-param="row.allergen.value"/>
                </div>
            {% endfor %}

            <p class="card__group card__group--second">Not detected</p>
            {% for row in view.notDetected %}
                <div class="allergen allergen--compact">
                    <div class="allergen__text">
                        {% if row.active %}
                            <span class="allergen__plain"><span class="allergen__sans">sans </span>{{ row.label|lower }}{% if row.free %} <span class="allergen__free">· already free</span>{% endif %}</span>
                        {% else %}
                            <span class="allergen__plain allergen__plain--idle">{{ row.label }}</span>
                        {% endif %}
                    </div>
                    <twig:AllergenToggle :label="row.label" :pressed="row.active" :busy="row.busy" size="small" data-action="live#action" data-live-action-param="toggleAllergen" :data-live-allergen-param="row.allergen.value"/>
                </div>
            {% endfor %}

            <button class="card__reset" type="button" data-action="live#action" data-live-action-param="reset">Back to the original recipe</button>

        {% endif %}

        <p class="card__disclaimer" id="how">Sans reads the recipe text, not product labels. If you cook for an allergy, always check the packaging.</p>
    </aside>
</div>
