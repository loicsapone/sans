{
    "name": "loicsapone/sans",
    "description": "Paste a recipe URL and see which of the 14 EU allergens it contains, with allergen-free adaptations.",
    "type": "project",
    "license": "MIT",
    "minimum-stability": "beta",
    "prefer-stable": true,
    "require": {
        "php": ">=8.5",
        "ext-ctype": "*",
        "ext-dom": "*",
        "ext-iconv": "*",
        "doctrine/doctrine-bundle": "^3.4",
        "doctrine/orm": "^3.8",
        "j0k3r/php-readability": "^2.0",
        "nyholm/psr7": "^1.8",
        "symfony/ai-agent": "^1.0@beta",
        "symfony/ai-bundle": "^1.0@beta",
        "symfony/ai-mcp-tool": "^1.0@beta",
        "symfony/ai-meilisearch-store": "^1.0@beta",
        "symfony/ai-mistral-platform": "^1.0@beta",
        "symfony/ai-similarity-search-tool": "^1.0@beta",
        "symfony/asset-mapper": "8.2.*",
        "symfony/console": "8.2.*",
        "symfony/dotenv": "8.2.*",
        "symfony/flex": "^2.12",
        "symfony/framework-bundle": "8.2.*",
        "symfony/http-client": "8.2.*",
        "symfony/mcp-bundle": "^0.15.0",
        "symfony/monolog-bundle": "^4.1",
        "symfony/runtime": "8.2.*",
        "symfony/stimulus-bundle": "^3.7",
        "symfony/twig-bundle": "8.2.*",
        "symfony/uid": "8.2.*",
        "symfony/ux-live-component": "^3.7",
        "symfony/ux-twig-component": "^3.7",
        "symfony/validator": "8.2.*",
        "symfony/yaml": "8.2.*",
        "twig/extra-bundle": "^2.12|^3.0",
        "twig/twig": "^2.12|^3.0"
    },
    "config": {
        "allow-plugins": {
            "php-http/discovery": true,
            "symfony/flex": true,
            "symfony/runtime": true
        },
        "bump-after-update": true,
        "sort-packages": true
    },
    "autoload": {
        "psr-4": {
            "App\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "App\\Tests\\": "tests/"
        }
    },
    "replace": {
        "symfony/polyfill-ctype": "*",
        "symfony/polyfill-iconv": "*",
        "symfony/polyfill-php72": "*",
        "symfony/polyfill-php73": "*",
        "symfony/polyfill-php74": "*",
        "symfony/polyfill-php80": "*",
        "symfony/polyfill-php81": "*",
        "symfony/polyfill-php82": "*",
        "symfony/polyfill-php83": "*",
        "symfony/polyfill-php84": "*"
    },
    "scripts": {
        "auto-scripts": {
            "cache:clear": "symfony-cmd",
            "assets:install %PUBLIC_DIR%": "symfony-cmd",
            "importmap:install": "symfony-cmd"
        },
        "post-install-cmd": [
            "@auto-scripts"
        ],
        "post-update-cmd": [
            "@auto-scripts"
        ],
        "static:run": [
            "@static:run:php-cs-fixer",
            "@static:run:twig-cs-fixer",
            "@static:run:phpstan"
        ],
        "static:run:php-cs-fixer": "vendor/bin/php-cs-fixer fix",
        "static:run:twig-cs-fixer": "vendor/bin/twig-cs-fixer lint --fix",
        "static:run:phpstan": "vendor/bin/phpstan --memory-limit=1G",
        "test:run": [
            "@test:run:phpunit"
        ],
        "test:run:phpunit": "vendor/bin/phpunit"
    },
    "conflict": {
        "symfony/symfony": "*"
    },
    "extra": {
        "symfony": {
            "allow-contrib": true,
            "require": "8.2.*"
        }
    },
    "require-dev": {
        "dama/doctrine-test-bundle": "^8.8",
        "friendsofphp/php-cs-fixer": "^3.95",
        "phpstan/phpstan": "^2.3",
        "phpstan/phpstan-doctrine": "^2.1",
        "phpstan/phpstan-phpunit": "^2.1",
        "phpstan/phpstan-symfony": "^2.1",
        "phpunit/phpunit": "^13.4",
        "symfony/browser-kit": "8.2.*",
        "symfony/css-selector": "8.2.*",
        "symfony/debug-bundle": "8.2.*",
        "symfony/maker-bundle": "^1.68",
        "symfony/stopwatch": "8.2.*",
        "symfony/web-profiler-bundle": "8.2.*",
        "vincentlanglet/twig-cs-fixer": "^4.1"
    }
}
